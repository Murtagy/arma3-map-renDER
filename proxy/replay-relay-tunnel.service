[Unit]
Description=Outbound-only Cloudflare named tunnel for replay relay
Wants=network-online.target
Requires=replay-relay.service
After=network-online.target replay-relay.service

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/replay-relay/tunnel.token
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20242 --loglevel info run --token-file ${CREDENTIALS_DIRECTORY}/tunnel-token
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryMax=192M
TasksMax=32
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
